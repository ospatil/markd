package components

import (
	"fmt"
	"strings"

	"github.com/ospatil/markd/internal/model"
)

templ BookmarkList(bookmarks []model.Bookmark) {
	@BookmarkListWithTag(bookmarks, "")
}

templ BookmarkListWithTag(bookmarks []model.Bookmark, activeTag string) {
	<div id="bookmark-list" class="grid gap-4">
		if activeTag != "" {
			<div class="flex items-center gap-2 text-sm opacity-70">
				<span>Filtered by tag:</span>
				<span class="badge badge-primary">{ activeTag }</span>
				<button
					class="btn btn-ghost btn-xs"
					hx-get="/"
					hx-target="#bookmark-list"
				>
					✕ Clear
				</button>
			</div>
		}
		if len(bookmarks) == 0 {
			@BookmarkEmpty()
		} else {
			for _, b := range bookmarks {
				@BookmarkItem(b)
			}
		}
	</div>
}

templ BookmarkItem(b model.Bookmark) {
	<div class="card bg-base-200" id={ fmt.Sprintf("bookmark-%s", b.ID) }>
		<div class="card-body p-4">
			<div class="flex items-start justify-between gap-4">
				<div class="min-w-0 flex-1">
					<a href={ templ.SafeURL(b.URL) } target="_blank" rel="noopener" class="font-medium hover:underline">
						{ b.Title }
					</a>
					<p class="text-sm opacity-60 truncate">{ b.URL }</p>
					if len(b.Tags) > 0 {
						<div class="mt-2 flex flex-wrap gap-1">
							for _, tag := range b.Tags {
								<span
									class="badge badge-secondary badge-sm cursor-pointer"
									hx-get={ fmt.Sprintf("/bookmarks/filter?tag=%s", tag) }
									hx-target="#bookmark-list"
									hx-swap="innerHTML"
								>
									{ tag }
								</span>
							}
						</div>
					}
				</div>
				<div class="flex gap-1">
					<button
						class="btn btn-ghost btn-xs btn-square"
						hx-get={ fmt.Sprintf("/bookmarks/%s/edit", b.ID) }
						hx-target={ fmt.Sprintf("#bookmark-%s", b.ID) }
						hx-swap="outerHTML"
					>
						✎
					</button>
					<button
						class="btn btn-ghost btn-xs btn-square"
						hx-delete={ fmt.Sprintf("/bookmarks/%s", b.ID) }
						hx-target={ fmt.Sprintf("#bookmark-%s", b.ID) }
						hx-swap="outerHTML"
						hx-confirm="Delete this bookmark?"
					>
						✕
					</button>
				</div>
			</div>
		</div>
	</div>
}

templ BookmarkEditForm(b model.Bookmark, folders []model.Folder, errors map[string]string) {
	<div class="card bg-base-200" id={ fmt.Sprintf("bookmark-%s", b.ID) }>
		<div class="card-body p-4">
			<form
				class="grid gap-3"
				hx-put={ fmt.Sprintf("/bookmarks/%s", b.ID) }
				hx-target={ fmt.Sprintf("#bookmark-%s", b.ID) }
				hx-swap="outerHTML"
			>
				<fieldset class="fieldset">
					<label class="fieldset-label" for={ fmt.Sprintf("edit-title-%s", b.ID) }>Title</label>
					<input
						id={ fmt.Sprintf("edit-title-%s", b.ID) }
						name="title"
						type="text"
						class="input input-bordered w-full"
						value={ b.Title }
						if errors["title"] != "" {
							aria-invalid="true"
						}
						autofocus
					/>
					if errors["title"] != "" {
						<p class="text-error text-sm" role="alert">{ errors["title"] }</p>
					}
				</fieldset>
				<fieldset class="fieldset">
					<label class="fieldset-label" for={ fmt.Sprintf("edit-url-%s", b.ID) }>URL</label>
					<input
						id={ fmt.Sprintf("edit-url-%s", b.ID) }
						name="url"
						type="url"
						class="input input-bordered w-full"
						value={ b.URL }
						if errors["url"] != "" {
							aria-invalid="true"
						}
					/>
					if errors["url"] != "" {
						<p class="text-error text-sm" role="alert">{ errors["url"] }</p>
					}
				</fieldset>
				<fieldset class="fieldset">
					<label class="fieldset-label" for={ fmt.Sprintf("edit-tags-%s", b.ID) }>Tags</label>
					<input
						id={ fmt.Sprintf("edit-tags-%s", b.ID) }
						name="tags"
						type="text"
						class="input input-bordered w-full"
						value={ strings.Join(b.Tags, ", ") }
					/>
				</fieldset>
				if len(folders) > 0 {
					<fieldset class="fieldset">
						<label class="fieldset-label" for={ fmt.Sprintf("edit-folder-%s", b.ID) }>Folder</label>
						<select id={ fmt.Sprintf("edit-folder-%s", b.ID) } name="folder_id" class="select select-bordered w-full">
							<option value="">None</option>
							for _, f := range folders {
								<option value={ f.ID } selected?={ f.ID == b.FolderID }>{ f.Name }</option>
							}
						</select>
					</fieldset>
				}
				<div class="flex gap-2 justify-end">
					<button
						type="button"
						class="btn btn-outline btn-sm"
						hx-get={ fmt.Sprintf("/bookmarks/%s", b.ID) }
						hx-target={ fmt.Sprintf("#bookmark-%s", b.ID) }
						hx-swap="outerHTML"
					>
						Cancel
					</button>
					<button type="submit" class="btn btn-primary btn-sm">Save</button>
				</div>
			</form>
		</div>
	</div>
}

templ BookmarkEmpty() {
	<div class="py-12 text-center opacity-60">
		<p class="text-lg">No bookmarks yet</p>
		<p class="text-sm">Add your first bookmark to get started.</p>
	</div>
}

templ IndexPage(bookmarks []model.Bookmark, folders []model.Folder, activeFolder string) {
	@Layout("Bookmarks") {
		<div class="flex gap-6">
			@FolderSidebar(folders, activeFolder)
			<div class="flex-1">
				@BookmarkList(bookmarks)
			</div>
		</div>
	}
}
