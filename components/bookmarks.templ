package components

import (
  "fmt"
  "strings"
  "github.com/ospatil/markd/internal/model"
)

templ BookmarkList(bookmarks []model.Bookmark) {
  @BookmarkListWithTag(bookmarks, "")
}

templ BookmarkListWithTag(bookmarks []model.Bookmark, activeTag string) {
  <div id="bookmark-list" class="grid gap-4">
    if activeTag != "" {
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <span>Filtered by tag:</span>
        <span class="badge">{ activeTag }</span>
        <button
          class="btn-sm-ghost"
          hx-get="/"
          hx-target="#bookmark-list"
        >
          ✕ Clear
        </button>
      </div>
    }
    if len(bookmarks) == 0 {
      @BookmarkEmpty()
    } else {
      for _, b := range bookmarks {
        @BookmarkItem(b)
      }
    }
  </div>
}

templ BookmarkItem(b model.Bookmark) {
  <div class="card" id={ fmt.Sprintf("bookmark-%s", b.ID) }>
    <section class="flex items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        <a href={ templ.SafeURL(b.URL) } target="_blank" rel="noopener" class="font-medium hover:underline">
          { b.Title }
        </a>
        <p class="text-sm text-muted-foreground truncate">{ b.URL }</p>
        if len(b.Tags) > 0 {
          <div class="mt-2 flex flex-wrap gap-1">
            for _, tag := range b.Tags {
              <span
                class="badge-secondary cursor-pointer"
                hx-get={ fmt.Sprintf("/bookmarks/filter?tag=%s", tag) }
                hx-target="#bookmark-list"
                hx-swap="innerHTML"
              >
                { tag }
              </span>
            }
          </div>
        }
      </div>
      <div class="flex gap-1">
        <button
          class="btn-sm-icon-ghost"
          hx-get={ fmt.Sprintf("/bookmarks/%s/edit", b.ID) }
          hx-target={ fmt.Sprintf("#bookmark-%s", b.ID) }
          hx-swap="outerHTML"
        >
          ✎
        </button>
        <button
          class="btn-sm-icon-ghost"
          hx-delete={ fmt.Sprintf("/bookmarks/%s", b.ID) }
          hx-target={ fmt.Sprintf("#bookmark-%s", b.ID) }
          hx-swap="outerHTML"
          hx-confirm="Delete this bookmark?"
        >
          ✕
        </button>
      </div>
    </section>
  </div>
}

templ BookmarkEditForm(b model.Bookmark, folders []model.Folder, errors map[string]string) {
  <div class="card" id={ fmt.Sprintf("bookmark-%s", b.ID) }>
    <section>
      <form
        class="form grid gap-3"
        hx-put={ fmt.Sprintf("/bookmarks/%s", b.ID) }
        hx-target={ fmt.Sprintf("#bookmark-%s", b.ID) }
        hx-swap="outerHTML"
      >
        <div role="group" class="field">
          <label for={ fmt.Sprintf("edit-title-%s", b.ID) }>Title</label>
          <input
            id={ fmt.Sprintf("edit-title-%s", b.ID) }
            name="title"
            type="text"
            value={ b.Title }
            if errors["title"] != "" {
              aria-invalid="true"
            }
            autofocus
          />
          if errors["title"] != "" {
            <p role="alert">{ errors["title"] }</p>
          }
        </div>
        <div role="group" class="field">
          <label for={ fmt.Sprintf("edit-url-%s", b.ID) }>URL</label>
          <input
            id={ fmt.Sprintf("edit-url-%s", b.ID) }
            name="url"
            type="url"
            value={ b.URL }
            if errors["url"] != "" {
              aria-invalid="true"
            }
          />
          if errors["url"] != "" {
            <p role="alert">{ errors["url"] }</p>
          }
        </div>
        <div role="group" class="field">
          <label for={ fmt.Sprintf("edit-tags-%s", b.ID) }>Tags</label>
          <input
            id={ fmt.Sprintf("edit-tags-%s", b.ID) }
            name="tags"
            type="text"
            value={ strings.Join(b.Tags, ", ") }
          />
        </div>
        if len(folders) > 0 {
          <div role="group" class="field">
            <label for={ fmt.Sprintf("edit-folder-%s", b.ID) }>Folder</label>
            <select id={ fmt.Sprintf("edit-folder-%s", b.ID) } name="folder_id" class="select w-full">
              <option value="">None</option>
              for _, f := range folders {
                <option value={ f.ID } selected?={ f.ID == b.FolderID }>{ f.Name }</option>
              }
            </select>
          </div>
        }
        <div class="flex gap-2 justify-end">
          <button
            type="button"
            class="btn-sm-outline"
            hx-get={ fmt.Sprintf("/bookmarks/%s", b.ID) }
            hx-target={ fmt.Sprintf("#bookmark-%s", b.ID) }
            hx-swap="outerHTML"
          >
            Cancel
          </button>
          <button type="submit" class="btn-sm">Save</button>
        </div>
      </form>
    </section>
  </div>
}

templ BookmarkEmpty() {
  <div class="py-12 text-center text-muted-foreground">
    <p class="text-lg">No bookmarks yet</p>
    <p class="text-sm">Add your first bookmark to get started.</p>
  </div>
}

templ IndexPage(bookmarks []model.Bookmark, folders []model.Folder, activeFolder string) {
  @Layout("Bookmarks") {
    <div class="flex gap-6">
      @FolderSidebar(folders, activeFolder)
      <div class="flex-1">
        @BookmarkList(bookmarks)
      </div>
    </div>
  }
}
