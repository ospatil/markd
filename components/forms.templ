package components

import "github.com/ospatil/markd/internal/model"

type BookmarkFormData struct {
	Title string
	URL   string
	Tags  string
}

templ BookmarkFormDialog(data BookmarkFormData, folders []model.Folder, errors map[string]string) {
	<dialog
		id="add-bookmark-dialog"
		class="modal"
		data-controller="dialog"
		data-action="click->dialog#backdropClose"
	>
		<div class="modal-box">
			<h3 class="text-lg font-bold">Add Bookmark</h3>
			<p class="py-2 opacity-60">Save a new bookmark with optional tags.</p>
			<form
				id="add-bookmark-form"
				class="grid gap-4"
				data-hx-post="/bookmarks"
				data-hx-target="#bookmark-list"
				data-hx-swap="afterbegin"
				data-hx-status:422="target:#form-errors swap:innerHTML"
			>
				<fieldset class="fieldset">
					<label class="fieldset-label" for="bookmark-title">Title</label>
					<input
						id="bookmark-title"
						name="title"
						type="text"
						class="input input-bordered w-full"
						placeholder="My Bookmark"
						value={ data.Title }
						if errors["title"] != "" {
							aria-invalid="true"
							aria-describedby="title-error"
						}
						autofocus
					/>
					if errors["title"] != "" {
						<p id="title-error" class="text-error text-sm" role="alert">{ errors["title"] }</p>
					}
				</fieldset>
				<fieldset class="fieldset">
					<label class="fieldset-label" for="bookmark-url">URL</label>
					<input
						id="bookmark-url"
						name="url"
						type="url"
						class="input input-bordered w-full"
						placeholder="https://example.com"
						value={ data.URL }
						if errors["url"] != "" {
							aria-invalid="true"
							aria-describedby="url-error"
						}
					/>
					if errors["url"] != "" {
						<p id="url-error" class="text-error text-sm" role="alert">{ errors["url"] }</p>
					}
				</fieldset>
				<fieldset class="fieldset">
					<label class="fieldset-label" for="bookmark-tags">Tags</label>
					<input
						id="bookmark-tags"
						name="tags"
						type="text"
						class="input input-bordered w-full"
						placeholder="go, htmx, web (comma separated)"
						value={ data.Tags }
					/>
				</fieldset>
				if len(folders) > 0 {
					<fieldset class="fieldset">
						<label class="fieldset-label" for="bookmark-folder">Folder</label>
						<select id="bookmark-folder" name="folder_id" class="select select-bordered w-full">
							<option value="">None</option>
							for _, f := range folders {
								<option value={ f.ID }>{ f.Name }</option>
							}
						</select>
					</fieldset>
				}
				<div id="form-errors"></div>
			</form>
			<div class="modal-action">
				<button class="btn btn-outline" data-action="click->dialog#close">Cancel</button>
				<button class="btn btn-primary" type="submit" form="add-bookmark-form">Save</button>
			</div>
			<button type="button" class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" data-action="click->dialog#close">✕</button>
		</div>
		<form method="dialog" class="modal-backdrop"><button>close</button></form>
	</dialog>
}

templ FormErrors(errors map[string]string) {
	for field, msg := range errors {
		<p role="alert" class="text-sm text-error">{ field }: { msg }</p>
	}
}
