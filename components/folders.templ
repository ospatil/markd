package components

import (
	"fmt"

	"github.com/ospatil/markd/internal/model"
)

templ FolderSidebar(folders []model.Folder, activeID string) {
	<nav id="folder-sidebar" class="w-56 shrink-0">
		<ul class="menu bg-base-200 rounded-box w-full">
			<li class="menu-title">Folders</li>
			<li>
				<a
					href="/"
					class={ templ.KV("active", activeID == "") }
					data-hx-get="/"
					data-hx-target="#bookmark-list"
					data-hx-push-url="true"
				>
					All Bookmarks
				</a>
			</li>
			for _, f := range folders {
				<li>
					<div class="flex items-center justify-between">
						<a
							href={ templ.SafeURL(fmt.Sprintf("/?folder=%s", f.ID)) }
							class={ "flex-1", templ.KV("active", activeID == f.ID) }
							data-hx-get={ fmt.Sprintf("/?folder=%s", f.ID) }
							data-hx-target="#bookmark-list"
							data-hx-push-url="true"
						>
							{ f.Name }
						</a>
						<button
							class="btn btn-ghost btn-xs btn-square opacity-0 group-hover:opacity-100"
							data-hx-delete={ fmt.Sprintf("/folders/%s", f.ID) }
							data-hx-target="#folder-sidebar"
							data-hx-swap="outerHTML"
							data-hx-confirm={ fmt.Sprintf("Delete folder '%s'?", f.Name) }
						>
							✕
						</button>
					</div>
				</li>
			}
			<li>
				<form
					class="flex gap-1 p-0"
					data-hx-post="/folders"
					data-hx-target="#folder-sidebar"
					data-hx-swap="outerHTML"
				>
					<input
						name="name"
						type="text"
						placeholder="New folder..."
						class="input input-bordered input-sm flex-1"
						required
					/>
					<button type="submit" class="btn btn-outline btn-sm">+</button>
				</form>
			</li>
		</ul>
	</nav>
}
