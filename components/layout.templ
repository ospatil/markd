package components

templ Layout(title string) {
  <!DOCTYPE html>
  <html lang="en" data-theme="dark">
    <head>
      <meta charset="UTF-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
      <title>{ title } - markd</title>
      <script>
        (() => {
          try {
            const stored = localStorage.getItem('themeMode');
            const dark = stored ? stored === 'dark'
                        : matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
          } catch (_) {}
          document.addEventListener('toggleTheme', () => {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('themeMode', next); } catch (_) {}
          });
        })();
      </script>
      <link rel="stylesheet" href="/static/css/app.css"/>
      <script src="/static/vendor/htmx.min.js"></script>
      <script src="/static/vendor/hx-preload.js"></script>
      <script src="/static/js/bundle.js" defer></script>
      <script>
        document.addEventListener('closeDialog', () => {
          const d = document.getElementById('add-bookmark-dialog');
          if (d) { d.close(); d.querySelector('form')?.reset();
            const errors = d.querySelector('#form-errors');
            if (errors) errors.innerHTML = '';
          }
        });
      </script>
    </head>
    <body class="min-h-screen bg-base-100" data-hx-preload="mouseover"
          data-controller="shortcuts">
      <div class="navbar bg-base-200">
        <div class="container mx-auto flex items-center justify-between">
          <div class="flex-none">
            <a href="/" class="text-xl font-bold" data-hx-get="/" data-hx-target="#bookmark-list" data-hx-push-url="true">markd</a>
          </div>
          <div class="flex-none flex items-center gap-2">
            <input
              type="search"
              name="q"
              placeholder="Search... (Ctrl+K)"
              class="input input-bordered w-64"
              data-hx-get="/bookmarks/search"
              data-hx-trigger="input changed delay:300ms"
              data-hx-target="#bookmark-list"
              data-shortcuts-target="search"
            />
            <button
              class="btn btn-primary"
              onclick="document.getElementById('add-bookmark-dialog').showModal()"
            >
              + Add Bookmark
            </button>
            <button
              type="button"
              aria-label="Toggle dark mode"
              onclick="document.dispatchEvent(new CustomEvent('toggleTheme'))"
              class="btn btn-ghost btn-square"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
            </button>
          </div>
        </div>
      </div>
      <main class="container mx-auto px-4 py-6">
        { children... }
      </main>
      @BookmarkFormDialog(BookmarkFormData{}, nil, nil)
    </body>
  </html>
}
